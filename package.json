{
  "name": "@touchque/node",
  "version": "3.0.0",
  "description": "Official Node.js SDK for TouchQue Authenticator (2FA/MFA, passkeys, adaptive auth)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Touchque/touchque-nodejs"
  },
  "homepage": "https://touchque.com",
  "license": "MIT",
  "author": "TouchQue",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "touchque",
    "touchque-authenticator",
    "auth",
    "2fa",
    "mfa",
    "passkey",
    "webauthn",
    "authentication"
  ],
  "dependencies": {
    "axios": "^1.12.0"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
